# CRO212HUB NFT Generator - Environment Variables

# ===================================
# API Configuration
# ===================================
NEXT_PUBLIC_API_URL=http://localhost:5000

# ===================================
# Web3 Configuration
# ===================================
# Get your WalletConnect Project ID from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ===================================
# Blockchain Configuration
# ===================================
# Cronos Testnet RPC (Chain ID: 338)
NEXT_PUBLIC_CRONOS_TESTNET_RPC=https://evm-t3.cronos.org

# Cronos Mainnet RPC (Chain ID: 25)
NEXT_PUBLIC_CRONOS_MAINNET_RPC=https://evm.cronos.org

# Default Chain (testnet or mainnet)
NEXT_PUBLIC_DEFAULT_CHAIN=testnet

# ===================================
# Contract Addresses
# ===================================
# Deployed contract address (optional, for deployed projects)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# ===================================
# IPFS Configuration (Optional)
# ===================================
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_KEY=

# ===================================
# Application Configuration
# ===================================
NEXT_PUBLIC_APP_NAME=CRO212HUB NFT Generator
NEXT_PUBLIC_APP_VERSION=2.0.0
